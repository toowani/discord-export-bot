{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-export-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // Discord sends interactions here; only this subdomain is added to toowani.com.
  "routes": [{ "pattern": "discord-bot.toowani.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "EXPORTER", "class_name": "ExportJob" }]
  },
  // SQLite-backed Durable Objects are the only kind available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExportJob"] }],
  "vars": { "ALLOWED_ROLE": "대화내보내기" }
  // Secrets (wrangler secret put): DISCORD_TOKEN, DISCORD_PUBLIC_KEY, DISCORD_GUILD_ID, ADMIN_TOKEN
}
